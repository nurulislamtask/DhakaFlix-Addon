# Copy to .env (never commit .env itself — it may hold your TMDB key).
VITE_HTTP_SERVER_URL=http://cdn.dflix.live
# Free TMDB API key (v3) — required for movie posters. Get one at
# https://www.themoviedb.org/settings/api (Settings -> API -> "API Key (v3 auth)").
# You can also paste the key in the app header instead of using this file.
VITE_TMDB_API_KEY=
